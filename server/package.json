{
  "name": "ims-server",
  "version": "1.0.0",
  "description": "Intern Management System Modular Monolith API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "seed": "node src/database/seed.js",
    "reset:demo": "node src/database/resetDemoData.js --confirm",
    "reset:all": "node src/database/resetAllTestData.js --confirm",
    "reset:dry": "node src/database/resetAllTestData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.4",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
