# ====================================================================
# QA / TEST ENVIRONMENT  -  used ONLY by the Cypress and Jest suites.
# Isolated database (tmt_qa), isolated ports, no real secrets, no real email.
# Never point MONGO_URI here at a database that holds real data: scripts/qa-reset.js drops it.
# ====================================================================
NODE_ENV=qa
PORT=5100
APP_URL=http://localhost:5100
CLIENT_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3100

MONGO_URI=mongodb://127.0.0.1:27017/tmt_qa

JWT_ACCESS_SECRET=qa_only_access_secret_not_for_production_0123456789
JWT_REFRESH_SECRET=qa_only_refresh_secret_not_for_production_0123456789
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=4

STORAGE_PROVIDER=local
UPLOAD_DIR=./qa-artifacts/uploads
TEMP_UPLOAD_DIR=./qa-artifacts/uploads/temp

# Automated suites hammer the API from one IP.
RATE_LIMIT_DISABLED=true

# Lets the Cypress atomicity test make a provisioning step fail on purpose (honoured ONLY when NODE_ENV=qa|test)
QA_FAULT_INJECTION=true

ORG_TIMEZONE=Asia/Kolkata
OFFER_VALIDITY_DAYS=7
