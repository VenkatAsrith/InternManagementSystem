# ====================================================================
# INTERN MANAGEMENT SYSTEM (IMS) - ENTERPRISE ENVIRONMENT CONFIG
# ====================================================================

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/intern_management_system

# JWT & Authentication
JWT_ACCESS_SECRET=ims_jwt_super_secret_access_key_2026_!@#$%^
JWT_REFRESH_SECRET=ims_jwt_super_secret_refresh_key_2026_&*()_+
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=tmt_cookie_signing_secret_2026_!@#$%
BCRYPT_SALT_ROUNDS=10

# Storage
STORAGE_PROVIDER=cloudinary
UPLOAD_DIR=./uploads
TEMP_UPLOAD_DIR=./uploads/temp
MAX_FILE_SIZE=10485760

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true


