# ====================================================================
# INTERN MANAGEMENT SYSTEM (IMS) - ENTERPRISE ENVIRONMENT CONFIG
# ====================================================================
# TechMecha Torque (TMT) Platform Configuration

# --------------------------------------------------------------------
# 1. Server & Environment
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------
# 2. Database (MongoDB)
# --------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/intern_management_system

# --------------------------------------------------------------------
# 3. Security & Authentication (JWT & Sessions)
# --------------------------------------------------------------------
JWT_ACCESS_SECRET=tmt_access_secret_super_secure_key_2026_enterprise_!@#
JWT_REFRESH_SECRET=tmt_refresh_secret_super_secure_key_2026_enterprise_$%^
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=tmt_cookie_signing_secret_2026_!@#$%

# --------------------------------------------------------------------
# 4. Storage Architecture (Local & Cloudinary)
# --------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
TEMP_UPLOAD_DIR=./uploads/temp
MAX_FILE_SIZE=10485760

# Cloudinary Storage Credentials (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true

# --------------------------------------------------------------------
# 5. SMTP Enterprise Email Engine
# --------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="TechMecha Torque Talent Operations"
SMTP_FROM_EMAIL=careers@techmechatorque.com

# --------------------------------------------------------------------
# 6. Rate Limiting
# --------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=10

# --------------------------------------------------------------------
# 7. Logging & Observability
# --------------------------------------------------------------------
LOG_LEVEL=info
